{
  "name": "the-coop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:site": "vite --mode sites --host 127.0.0.1 --port 5174 --strictPort",
    "dev:server": "tsx watch src/server/index.ts",
    "start:production": "node src/server/production.ts",
    "clean:dist": "node scripts/clean-dist.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:site": "tsc --project tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:site": "playwright test --config playwright.sites.config.ts",
    "smoke:vps": "node scripts/vps-smoke.mjs",
    "build": "npm run typecheck && npm run clean:dist && vite build",
    "build:site": "npm run typecheck && npm run typecheck:site && npm run clean:dist && vite build --mode sites",
    "preview:site": "vite preview --mode sites --host 127.0.0.1 --port 4174 --strictPort",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@colyseus/core": "0.17.45",
    "@colyseus/schema": "4.0.30",
    "@colyseus/sdk": "0.17.43",
    "@colyseus/ws-transport": "0.17.13",
    "@modelcontextprotocol/sdk": "1.29.0",
    "drizzle-orm": "^0.45.2",
    "three": "0.185.1",
    "zod": "4.4.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@cloudflare/workers-types": "^4.20260515.1",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "@types/three": "0.185.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.8.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "^4.92.0"
  }
}
